# ---------------------------------------------------------------------------
# Kosvia — environment variables
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://kosvia:kosvia@localhost:5433/kosvia?schema=public

# Auth
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Leave COOKIE_DOMAIN empty: the browser reaches the API through the Nuxt
# proxy (/api), so cookies are first-party. Only set it when the API is
# deliberately served from a sibling host such as api.kosvia.pl.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# URLs
API_PORT=3001
# Direct API address — used by tooling and the Swagger docs. The browser never
# calls it: the Nuxt app proxies /api/** to API_INTERNAL_URL.
API_URL=http://localhost:3001
# Where the Nuxt server reaches the API (SSR and the /api proxy). Differs from
# API_URL when the API sits behind an internal hostname in production.
API_INTERNAL_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Hide the seeded demo catalogue (fictional brands, generated prices) from all
# public surfaces, leaving only imported products. Admin still sees everything.
HIDE_DEMO_DATA=false

# AI provider — leave AI_PROVIDER=mock to run fully offline.
# AI_PROVIDER=anthropic requires AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-opus-5

# Demo seed account passwords (seed only)
SEED_USER_PASSWORD=Password123!
SEED_ADMIN_PASSWORD=Admin123!
