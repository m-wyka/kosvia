# ---------------------------------------------------------------------------
# Kosvia — environment variables
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://kosvia:kosvia@localhost:5433/kosvia?schema=public

# Auth
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# URLs
API_PORT=3001
# Where the browser reaches the API.
API_URL=http://localhost:3001
# Where the Nuxt server reaches the API during SSR. Usually the same; differs
# when the API sits behind an internal hostname in production.
API_INTERNAL_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# AI provider — leave AI_PROVIDER=mock to run fully offline.
# AI_PROVIDER=anthropic requires AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-opus-5

# Demo seed account passwords (seed only)
SEED_USER_PASSWORD=Password123!
SEED_ADMIN_PASSWORD=Admin123!
