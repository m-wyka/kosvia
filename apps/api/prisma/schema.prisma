// Kosvia — database schema
//
// Design notes:
//  * Relational wherever a relationship carries meaning (product ↔ ingredient
//    position, profile ↔ concerns/goals, offers ↔ stores). JSON is only used
//    for the AI suggestion payload, which is genuinely document-shaped.
//  * Every column used for filtering or sorting at catalogue scale is indexed;
//    the schema is meant to hold hundreds of thousands of products.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* -------------------------------------------------------------------------- */
/* Enums                                                                      */
/* -------------------------------------------------------------------------- */

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  FREE
  PREMIUM
  CANCELLED
}

enum SkinType {
  DRY
  OILY
  COMBINATION
  NORMAL
  SENSITIVE
  UNKNOWN
}

enum SensitivityLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum FragrancePreference {
  NO_PREFERENCE
  PREFER_FRAGRANCE_FREE
  REQUIRE_FRAGRANCE_FREE
}

enum BudgetTier {
  UNDER_30
  UNDER_50
  UNDER_100
  UNDER_200
  NO_LIMIT
}

enum Availability {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum MessageRole {
  USER
  ASSISTANT
}

/// Where a category sits in a skincare routine. Powers routine gap analysis
/// and the future smart-basket builder.
enum RoutineStep {
  CLEANSER
  TONER
  EXFOLIANT
  SERUM
  EYE
  MOISTURIZER
  SPF
  MASK
  TREATMENT
  BODY
  HAIR
  MAKEUP
  OTHER
}

/* -------------------------------------------------------------------------- */
/* Identity                                                                   */
/* -------------------------------------------------------------------------- */

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  name               String?
  role               UserRole           @default(USER)
  subscriptionStatus SubscriptionStatus @default(FREE)
  /// Age gate (16+ in Poland for information-society services). Optional for
  /// accounts created before the gate existed.
  birthDate          DateTime?
  /// Last login or token refresh — drives the inactivity retention policy.
  lastActiveAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  beautyProfile BeautyProfile?
  shelfItems    UserShelfItem[]
  priceAlerts   PriceAlert[]
  conversations AIConversation[]
  comparisons   ProductComparison[]
  refreshTokens RefreshToken[]
  submissions   ProductSubmission[]
  consents      UserConsent[]
  deletionRequest AccountDeletionRequest?

  @@index([role])
  @@map("users")
}

enum ConsentType {
  TERMS
  PRIVACY
  BEAUTY_PROFILE_HEALTH
  AI_PROCESSING
  MARKETING_EMAIL
}

/// Consent is an event with history, never a boolean on User: we have to be
/// able to show when, and to which document version, someone agreed.
model UserConsent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  version   String
  granted   Boolean
  grantedAt DateTime?
  revokedAt DateTime?
  /// SHA-256 of the IP with a server salt — never the raw address.
  ipHash    String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("user_consents")
}

enum DeletionStatus {
  PENDING
  CANCELLED
  EXECUTED
}

/// A 7-day grace period before the hard delete, so "I changed my mind" works.
model AccountDeletionRequest {
  id          String         @id @default(cuid())
  userId      String         @unique
  status      DeletionStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  executeAt   DateTime
  cancelledAt DateTime?
  executedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, executeAt])
  @@map("account_deletion_requests")
}

/// Proof that a deletion happened, with nothing personal left behind.
model DeletionAudit {
  id        String   @id @default(cuid())
  idHash    String
  deletedAt DateTime @default(now())

  @@map("deletion_audits")
}

/// Hashed refresh tokens, one row per active session. Enables real logout and
/// refresh-token rotation without keeping raw tokens anywhere.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/* -------------------------------------------------------------------------- */
/* Beauty profile                                                             */
/* -------------------------------------------------------------------------- */

model BeautyProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  skinType              SkinType            @default(UNKNOWN)
  sensitivity           SensitivityLevel    @default(UNKNOWN)
  budget                BudgetTier          @default(NO_LIMIT)
  fragrancePreference   FragrancePreference @default(NO_PREFERENCE)
  veganPreference       Boolean             @default(false)
  crueltyFreePreference Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  concerns            BeautyConcern[] @relation("ProfileConcerns")
  goals               BeautyGoal[]    @relation("ProfileGoals")
  preferredBrands     Brand[]         @relation("ProfilePreferredBrands")
  excludedBrands      Brand[]         @relation("ProfileExcludedBrands")
  excludedIngredients Ingredient[]    @relation("ProfileExcludedIngredients")

  @@map("beauty_profiles")
}

model BeautyConcern {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  profiles    BeautyProfile[] @relation("ProfileConcerns")
  ingredients Ingredient[]    @relation("IngredientTargetsConcerns")

  @@map("beauty_concerns")
}

model BeautyGoal {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  profiles    BeautyProfile[] @relation("ProfileGoals")
  ingredients Ingredient[]    @relation("IngredientSupportsGoals")

  @@map("beauty_goals")
}

/* -------------------------------------------------------------------------- */
/* Catalogue                                                                  */
/* -------------------------------------------------------------------------- */

model Brand {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  logo          String?
  description   String?
  isVegan       Boolean @default(false)
  isCrueltyFree Boolean @default(false)

  products          Product[]
  preferredByProfiles BeautyProfile[] @relation("ProfilePreferredBrands")
  excludedByProfiles  BeautyProfile[] @relation("ProfileExcludedBrands")

  @@index([name])
  @@map("brands")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  parentId    String?
  routineStep RoutineStep @default(OTHER)
  /// Ordering hint for navigation menus.
  sortOrder   Int         @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([routineStep])
  @@map("categories")
}

model Product {
  id              String     @id @default(cuid())
  ean             String?    @unique
  name            String
  slug            String     @unique
  brandId         String
  categoryId      String
  description     String?
  usage           String?
  imageUrl        String?
  volume          Float?
  volumeUnit      String?    @default("ml")
  /// Marketing-free factual highlights shown on the product page.
  highlights      String[]   @default([])
  isFragranceFree Boolean    @default(false)
  isVegan         Boolean    @default(false)
  isCrueltyFree   Boolean    @default(false)
  /// Skin types the manufacturer positions the product for.
  targetSkinTypes SkinType[] @default([])
  /// Denormalised deterministic ingredient quality score (0-100), recomputed
  /// whenever the ingredient list changes. Keeps list queries cheap.
  ingredientScore Int        @default(50)
  /// Denormalised cheapest active offer price, for sorting/filtering at scale.
  lowestPrice     Decimal?   @db.Decimal(10, 2)
  isActive        Boolean    @default(true)
  /// Generated in SQL from name, highlights and description — see the
  /// add_search_extensions_and_indexes migration. Prisma never writes it.
  searchVector    Unsupported("tsvector")?
  sourceId        String?
  /// The record's identifier inside its source (barcode for Open Beauty Facts).
  sourceRef       String?
  sourceUpdatedAt DateTime?
  /// Set by the admin UI; imports leave such rows alone.
  isManuallyEdited Boolean  @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  brand       Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients ProductIngredient[]
  traits      ProductTraits?
  offers      ProductOffer[]
  priceHistory PriceHistory[]
  submissions ProductSubmission[]
  source      DataSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  shelfItems  UserShelfItem[]
  priceAlerts PriceAlert[]

  @@index([brandId])
  @@index([categoryId])
  @@index([lowestPrice])
  @@index([ingredientScore])
  @@index([isActive, categoryId])
  @@index([name])
  @@unique([sourceId, sourceRef])
  @@map("products")
}

model Ingredient {
  id                String     @id @default(cuid())
  inciName          String     @unique
  /// Lowercase, ASCII-folded `inciName` — the key the INCI matcher looks up.
  normalizedName    String
  slug              String     @unique
  commonName        String?
  description       String?
  /// What the ingredient does, in plain language ("binds water in the skin").
  functions         String[]   @default([])
  /// Machine-readable functional tags, see INGREDIENT_TAGS in @kosvia/shared.
  tags              String[]   @default([])
  /// Neutral, informational note about when to take care. Never a health claim.
  concerns          String?
  comedogenicRating Int?
  /// -2 (often poorly tolerated by reactive skin) … +2 (actively soothing).
  sensitivityImpact Int        @default(0)
  goodForSkinTypes  SkinType[] @default([])
  isActiveIngredient Boolean   @default(false)

  products        ProductIngredient[]
  aliases         IngredientAlias[]
  suggestedFor    UnmatchedToken[]
  sourceId        String?
  source          DataSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  targetsConcerns BeautyConcern[]     @relation("IngredientTargetsConcerns")
  supportsGoals   BeautyGoal[]        @relation("IngredientSupportsGoals")
  excludedByProfiles BeautyProfile[]  @relation("ProfileExcludedIngredients")

  @@index([inciName])
  @@index([normalizedName])
  @@map("ingredients")
}

/// The join carries data: INCI position is meaningful (earlier = more of it).
/// `ingredientId` is null when the label token could not be matched to the
/// dictionary — `rawText` always keeps what the label said.
model ProductIngredient {
  id                 String  @id @default(cuid())
  productId          String
  ingredientId       String?
  rawText            String
  position           Int
  isAfterMayContain  Boolean @default(false)
  matchConfidence    Float   @default(1.0)
  concentrationRange String?
  sourceId           String?
  isManuallyEdited   Boolean @default(false)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  source     DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([productId, position])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model IngredientAlias {
  id           String    @id @default(cuid())
  ingredientId String
  /// Normalised form used for matching (lowercase, no diacritics).
  alias        String    @unique
  /// The alias exactly as it appeared on a label.
  aliasRaw     String
  kind         AliasKind
  confidence   Float     @default(1.0)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@map("ingredient_aliases")
}

enum AliasKind {
  SYNONYM
  TRANSLATION
  TYPO
  TRADE_NAME
  CI_NUMBER
}

/// Label tokens the matcher could not resolve, aggregated across products so
/// the admin queue can fix the most frequent ones first.
model UnmatchedToken {
  id                    String      @id @default(cuid())
  normalized            String      @unique
  rawSamples            String[]    @default([])
  occurrenceCount       Int         @default(1)
  suggestedIngredientId String?
  suggestedScore        Float?
  status                TokenStatus @default(PENDING)
  resolvedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  suggestedIngredient Ingredient? @relation(fields: [suggestedIngredientId], references: [id], onDelete: SetNull)

  @@index([status, occurrenceCount])
  @@map("unmatched_tokens")
}

enum TokenStatus {
  PENDING
  MAPPED
  NEW_INGREDIENT
  IGNORED
}

/// A user-submitted label (photo and/or text) waiting for review. Nothing
/// here reaches the catalogue without going through the admin queue.
model ProductSubmission {
  id            String           @id @default(cuid())
  userId        String?
  productId     String?
  ean           String?
  imageUrl      String?
  rawLabel      String?
  extractedText String?
  status        SubmissionStatus @default(PENDING)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ean])
  @@map("product_submissions")
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Denormalised, purely numeric view of a formula so the first pass of
/// Personal Match runs as one SQL expression over the whole catalogue.
/// Recomputed by ProductTraitsService whenever the ingredient list changes.
model ProductTraits {
  productId            String  @id
  hasFragrance         Boolean @default(false)
  hasFragranceAllergen Boolean @default(false)
  hasAlcoholDenat      Boolean @default(false)
  alcoholDenatPosition Int?
  hasEssentialOils     Boolean @default(false)
  hasSilicones         Boolean @default(false)
  hasSpf               Boolean @default(false)

  humectantScore       Float @default(0)
  emollientScore       Float @default(0)
  occlusiveScore       Float @default(0)
  antioxidantScore     Float @default(0)
  exfoliantScore       Float @default(0)
  soothingScore        Float @default(0)
  brighteningScore     Float @default(0)
  antiAgingScore       Float @default(0)
  sebumRegulationScore Float @default(0)

  skinFitDry         Float @default(0)
  skinFitOily        Float @default(0)
  skinFitCombination Float @default(0)
  skinFitNormal      Float @default(0)
  skinFitSensitive   Float @default(0)
  calmingLoad        Float @default(0)
  irritantLoad       Float @default(0)

  activeIngredientIds String[] @default([])
  concernSlugs        String[] @default([])
  goalSlugs           String[] @default([])
  /// 64 dims: 0–19 tag shares, 20–63 hashed presence of headline actives. See product-traits.ts.
  fingerprint         Unsupported("vector(64)")?

  ingredientCount  Int   @default(0)
  recognizedRatio  Float @default(0)
  dataCompleteness Float @default(0)
  traitsVersion    Int   @default(1)
  computedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([activeIngredientIds], type: Gin)
  @@index([concernSlugs], type: Gin)
  @@index([goalSlugs], type: Gin)
  @@index([hasFragrance, hasSpf])
  @@map("product_traits")
}

/// Where a record came from — required for ODbL/CC attribution and to keep
/// third-party data separable from our own. See 01_DANE_ZRODLA.md.
model DataSource {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  license     String
  attribution String?
  url         String?

  products           Product[]
  ingredients        Ingredient[]
  productIngredients ProductIngredient[]
  offers             ProductOffer[]
  importRuns         ImportRun[]

  @@map("data_sources")
}

/// Audit trail and resume cursor for every batch import.
model ImportRun {
  id         String          @id @default(cuid())
  sourceId   String
  status     ImportRunStatus @default(RUNNING)
  isDryRun   Boolean         @default(false)
  /// Free-form arguments the run was started with (category, limit…).
  params     Json?
  /// Where to pick up after an interruption — page number, category…
  cursor     Json?
  created    Int             @default(0)
  updated    Int             @default(0)
  skipped    Int             @default(0)
  queued     Int             @default(0)
  failed     Int             @default(0)
  errors     String[]        @default([])
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@map("import_runs")
}

enum ImportRunStatus {
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
}

/// Who changed what in the admin panel. Written by AdminAuditInterceptor
/// for every mutating admin request; the diff is the validated request body.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One row per search, no viewer identity: tells us which queries return
/// nothing and which brands people look for that we do not stock yet.
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  durationMs  Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("search_logs")
}

/* -------------------------------------------------------------------------- */
/* Commerce (seeded demo data only — no scraping)                             */
/* -------------------------------------------------------------------------- */

model Store {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  logo                 String?
  websiteUrl           String?
  /// e.g. "https://example.com/p/{sku}?aff=kosvia" — used once affiliate
  /// programmes are connected. Not used in the MVP.
  affiliateUrlTemplate String?

  offers       ProductOffer[]
  priceHistory PriceHistory[]

  @@map("stores")
}

model ProductOffer {
  id            String       @id @default(cuid())
  productId     String
  storeId       String
  price         Decimal      @db.Decimal(10, 2)
  currency      String       @default("PLN")
  url           String?
  availability  Availability @default(IN_STOCK)
  lastCheckedAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId String?
  source   DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([productId, price])
  @@index([storeId])
  @@map("product_offers")
}

/// Append-only price log. Populated by the seed today, by feed importers later.
model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  storeId    String
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("PLN")
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@map("price_history")
}

/* -------------------------------------------------------------------------- */
/* User-owned data                                                            */
/* -------------------------------------------------------------------------- */

model UserShelfItem {
  id         String    @id @default(cuid())
  userId     String
  productId  String
  addedAt    DateTime  @default(now())
  openedAt   DateTime?
  finishedAt DateTime?
  isFavorite Boolean   @default(false)
  notes      String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, addedAt])
  @@map("user_shelf_items")
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  targetPrice Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  notifiedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, active])
  @@map("price_alerts")
}

/// Comparison history — lets us restore a comparison from a shared link and,
/// later, learn which products people weigh against each other.
model ProductComparison {
  id         String   @id @default(cuid())
  userId     String?
  productIds String[]
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("product_comparisons")
}

/* -------------------------------------------------------------------------- */
/* AI Beauty Shopper                                                          */
/* -------------------------------------------------------------------------- */

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  /// Structured product suggestions rendered as cards in the chat. Genuinely
  /// document-shaped, and always derived from real rows retrieved beforehand.
  suggestions    Json?
  createdAt      DateTime    @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
